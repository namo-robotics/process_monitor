/* Command entry point for the Sun process monitor. */
using std;
/* Starts the monitor and reports user-facing failures. */
function main(argc: i32, argv: raw_ptr<raw_ptr<u8>>) i32 {
  return process_monitor.entry(argc, argv);
}

manifest {
  source_files: ["model.sun", "history.sun", "metrics.sun", "codec.sun", "ranking.sun",
    "options.sun", "labels.sun", "recording.sun", "posix.sun", "charts.sun", "terminal.sun", "app.sun"]
  target: {
    linux: { source_files: ["linux.sun"] test_files: ["../tests/linux.sun"] }
    macos: { source_files: ["darwin.sun"] test_files: ["../tests/darwin.sun"] }
  }
  libraries: ["stdlib.moon"]
  test_files: ["../tests/core.sun"]
}
