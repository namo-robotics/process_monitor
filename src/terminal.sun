/* Owns terminal state and renders resource views independently of collection. */
public module process_monitor {
  using std;

  /* Owns interactive display state and restores the terminal when released. */
  class Terminal {
    var trend: TrendGraph;
    var saved: ContiguousBuffer<u64>;
    var active: bool = false;
    var paused: bool = false;
    var help: bool = false;
    var finished: bool = false;
    var selected: String = String("");
    var selected_row: i64 = 0;
    var escape_state: i64 = 0;
    var selected_pid: i64 = 0;
    var selected_start: i64 = 0;
    var pending_signal: i32 = 0;
    var notice: String = String("");
    var rows: i64 = 24;
    var columns: i64 = 80;
    /* Initializes owned state and resources for this object. */
    init(a: const ref HeapAllocator, enabled: bool) throws IError {
      this.trend = TrendGraph(a);
      this.saved = ContiguousBuffer<u64>(a, 32);
      if (enabled and unsafe { pm_isatty(0); } == 1 and unsafe { pm_isatty(1); } == 1) {
        if (unsafe { pm_tcgetattr(0, this.saved.raw_data()); } != 0) {
          throw Error(1, "cannot read terminal settings");
        }
        var raw = ContiguousBuffer<u64>(a, 32);
        unsafe { _memcpy(raw.raw_data(), this.saved.raw_data(), 256); pm_cfmakeraw(raw.raw_data()); };
        if (unsafe { pm_tcsetattr(0, 0, raw.raw_data()); } != 0) {
          throw Error(1, "cannot set terminal mode");
        }
        this.active = true;
        var escape = String("\x1b[?1049h\x1b[?25l");
        output(escape);
      }
    }
    /* Releases owned resources and restores external state. */
    deinit() {
      if (this.active) {
        unsafe { pm_tcsetattr(0, 0, this.saved.raw_data()); };
        var escape = String("\x1b[0m\x1b[?25h\x1b[?1049l");
        output(escape);
      }
    }
    /* Reads available keys and reports whether the display needs refreshing. */
    method key(a: ref HeapAllocator, o: ref Options) bool throws IError {
      if (not this.active) {
        return false;
      }
      var old_rows: i64 = this.rows;
      var old_columns: i64 = this.columns;
      this.size(a);
      var poller = std.io.Poller(a);
      poller.add_read(0);
      var events = poller.wait(std.time.create_duration_millis(0));
      if (events.size() == 0) {
        return old_rows != this.rows or old_columns != this.columns;
      }
      this.notice.clear();
      var buffer = ContiguousBuffer<u8>(a, 32);
      var n = unsafe { pm_read(0, buffer.raw_data(), 32u64); };
      if (n == 0) {
        on_signal(0);
      }
      for (var i: i64 = 0; i < n; i = i + 1) {
        this.apply_key(buffer.get(i), o);
        this.perform_action(a, o);
      }
      return true;
    }

    /* Applies one terminal command to display state only. */
    method apply_key(ch: u8, o: ref Options) void {
      if (this.arrow_key(ch)) {
        return;
      }
      if (ch == b'q' or ch == 3u8) {
        on_signal(0);
      } else if (ch == b't') {
        this.pending_signal = 15;
      } else if (ch == b'k') {
        this.pending_signal = 9;
      } else if (ch == b' ') {
        this.paused = not this.paused;
      } else if (ch == b'h' or ch == b'?') {
        this.help = not this.help;
      } else if (ch == b'c') {
        o.memory = false;
      } else if (ch == b'm') {
        o.memory = true;
      } else if (ch == b'5') {
        o.top = 5;
      } else if (ch == b'0') {
        o.top = 10;
      } else if (ch == b'a') {
        o.top = 0;
      }
    }

    /* Executes a requested live-process action and reports the result while paused. */
    method perform_action(a: ref HeapAllocator, o: ref Options) void throws IError {
      if (this.pending_signal == 0) {
        return;
      }
      var signal: i32 = this.pending_signal;
      this.pending_signal = 0;
      if (not o.replay.is_empty()) {
        this.notice = String("Process actions are disabled during replay");
      } else if (this.selected.is_empty() or this.selected_pid == 0) {
        this.notice = String("Select a visible process before sending a signal");
      } else {
        this.notice = control_process(a, this.selected_pid, this.selected_start, signal);
      }
      if (this.active and this.paused) {
        var message = String("\x1b[H\x1b[2K");
        message.append(safe_text(a, this.notice, this.columns - 1));
        output(message);
      }
    }

    /* Decodes arrow sequences across reads and consumes other escape sequences. */
    method arrow_key(ch: u8) bool {
      if (ch == 27u8) {
        this.escape_state = 1;
        return true;
      }
      if (this.escape_state == 1) {
        this.escape_state = 0;
        if (ch == b'[' or ch == b'O') {
          this.escape_state = 2;
          return true;
        }
      } else if (this.escape_state == 2) {
        if (ch >= 64u8 and ch <= 126u8) {
          this.escape_state = 0;
          if (ch == b'A' or ch == b'B') {
            this.move_selection(ch == b'B');
          }
        }
        return true;
      }
      return false;
    }

    /* Moves the highlighted row while keeping the upper boundary in range. */
    method move_selection(down: bool) void {
      if (down) {
        this.selected_row = this.selected_row + 1;
      } else if (this.selected_row > 0) {
        this.selected_row = this.selected_row - 1;
      }
      this.selected.clear();
    }

    /* Refreshes the cached terminal dimensions. */
    method size(a: const ref HeapAllocator) void throws IError {
      var b = ContiguousBuffer<u16>(a, 4);
      b.fill(0);
      var request: u64 = 21523;
      if (_target_is("macos")) {
        request = 1074295912;
      }
      if (unsafe { pm_ioctl(1, request, b.raw_data()); } == 0) {
        this.rows = _convert<i64>(b.get(0));
        this.columns = _convert<i64>(b.get(1));
      }
    }
    /* Renders the table and top-process history without changing collected samples. */
    method draw(a: ref HeapAllocator, frame: ref Frame, history: ref History, o: ref Options) void throws IError {
      if (this.paused) {
        return;
      }
      this.size(a);
      var out = String("");
      if (this.active) {
        out.append("\x1b[H\x1b[2J");
      }
      if (this.active and (this.columns < 65 or this.rows < 17)) {
        out.append("Enlarge terminal to at least 65 columns and 17 rows. q quits.");
        output(out);
        return;
      }
      this.header(a, out, frame, history);
      this.table(a, out, frame, history, o);
      this.trend.duration = o.graph_window;
      this.trend.select(a, frame, o.memory);
      var style = TableStyle(this.columns, this.active);
      this.trend.draw(a, out, style, history, o.memory, this.graph_height());
      output(out);
    }

    /* Writes the resource and retention summary above the table. */
    method header(a: const ref HeapAllocator, out: ref String, frame: ref Frame, history: ref History) void throws IError {
      var style = TableStyle(this.columns, this.active);
      var title = String("PROCESS MONITOR  |  ");
      title.append(frame.processes.size());
      title.append(" processes  |  history ");
      title.append(history.window() / 1000);
      title.append("s  |  skipped ");
      title.append(frame.inaccessible);
      if (this.finished) {
        title.append("  |  REPLAY COMPLETE");
      }
      if (not this.notice.is_empty()) {
        title = this.notice.clone(a);
      }
      style.color(out, "\x1b[1;36m");
      out.append(safe_text(a, title, style.width));
      style.color(out, "\x1b[0m");
      out.append("\r\n");
      out.append("q quit  c/m sort  ↑/↓ select  t terminate  k kill  ? help\r\n");
      if (this.help and this.rows >= 21) {
        out.append("CPU: 100% = one core. Memory: resident MiB. N/A = unavailable.\r\n");
        out.append("5/0/a top 5/10/all. Space pauses display, not collection.\r\n");
      }
    }

    /* Keeps the selection attached to its identity as ranks change. */
    method locate_selection(a: const ref HeapAllocator, frame: ref Frame, order: ref Vec<i64>, count: i64) void throws IError {
      if (this.selected_row >= count) {
        this.selected_row = 0;
      }
      if (this.selected.is_empty() and count > 0) {
        this.selected = frame.processes.get(order.get(this.selected_row)).id();
        return;
      }
      for (var i: i64 = 0; i < count; i = i + 1) {
        var id = frame.processes.get(order.get(i)).id();
        if (id.equals(this.selected)) {
          this.selected_row = i;
          return;
        }
      }
    }

    /* Renders the current page of the requested ranking. */
    method table(a: ref HeapAllocator, out: ref String, frame: ref Frame, history: ref History, o: ref Options) void throws IError {
      var order = ranking(a, frame, o.memory);
      var count = order.size();
      if (o.top > 0 and count > o.top) {
        count = o.top;
      }
      this.locate_selection(a, frame, order, count);
      this.selected_pid = 0;
      var visible = this.rows - this.graph_height() - 15;
      if (this.help and this.rows >= 21) {
        visible = visible - 2;
      }
      if (not this.active) {
        visible = count;
      }
      var first: i64 = 0;
      if (this.selected_row >= visible) {
        first = this.selected_row - visible + 1;
      }
      var style = TableStyle(this.columns, this.active);
      style.rule(out, 0, true);
      this.headings(a, out, style, o.memory);
      style.rule(out, 1, true);
      for (var i = first; i < count and i < first + visible; i = i + 1) {
        this.row(a, out, frame.processes.get(order.get(i)));
      }
      style.rule(out, 2, true);
    }

    /* Labels the columns and marks the resource currently used for ranking. */
    method headings(a: const ref HeapAllocator, out: ref String, style: ref TableStyle, memory: bool) void throws IError {
      style.edge(out, "│", "|");
      var names = String("PID|NAME|CPU %|MEM %|RSS MiB");
      if (memory) {
        names = String("PID|NAME|CPU %|MEM %|RSS MiB *");
      } else {
        names = String("PID|NAME|CPU % *|MEM %|RSS MiB");
      }
      var headers = names.split(a, b'|');
      for (var col: i64 = 0; col < 5; col = col + 1) {
        style.color(out, "\x1b[1;36m");
        style.cell(a, out, headers.get(col), style.column(col), col != 1, false);
      }
      out.append("\r\n");
    }

    /* Formats aligned resource columns and highlights the selected identity. */
    method row(a: const ref HeapAllocator, out: ref String, p: ref Process) void throws IError {
      var style = TableStyle(this.columns, this.active);
      var id = p.id();
      var selected = id.equals(this.selected);
      var pid = String("");
      if (selected) {
        this.selected_pid = p.pid;
        this.selected_start = p.start;
        pid.append("> ");
      }
      pid.append(p.pid);
      var rss: f64 = -1.0;
      if (p.rss >= 0) {
        rss = _convert<f64>(p.rss) / 1048576.0;
      }
      var cells = Vec<String>(a, 5);
      cells.push(pid);
      cells.push(p.label.clone(a));
      cells.push(decimal(p.cpu));
      cells.push(decimal(p.memory));
      cells.push(decimal(rss));
      style.edge(out, "│", "|");
      for (var col: i64 = 0; col < 5; col = col + 1) {
        style.cell(a, out, cells.get(col), style.column(col), col != 1, selected);
      }
      out.append("\r\n");
    }

    /* Shares vertical space between the process table and the top-process graph. */
    method graph_height() i64 {
      var height = (this.rows - 14) / 3;
      if (height < 1) {
        return 1;
      }
      if (height > 8) {
        return 8;
      }
      return height;
    }
  }
}
